# GlowShine Co. Firebase Configuration
VITE_FIREBASE_API_KEY=AIzaSyDemoKeyForGlowShineCommerce
VITE_FIREBASE_AUTH_DOMAIN=glowshine-co.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=glowshine-co
VITE_FIREBASE_STORAGE_BUCKET=glowshine-co.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=100000000000
VITE_FIREBASE_APP_ID=1:100000000000:web:glowshine12345
