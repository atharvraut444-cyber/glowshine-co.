rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
    function validImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
          && request.resource.size < 2 * 1024 * 1024; // 2 MB max
    }

    match /products/{category}/{file} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
    }

    match /user-assets/{uid}/{file} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid && validImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
